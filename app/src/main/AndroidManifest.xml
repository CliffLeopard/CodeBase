<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.cleo.codebase">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CodeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodeBase"
        tools:ignore="AllowBackup">
        <activity
            android:name=".event.TouchEventActivity"
            android:exported="false" />
        <activity
            android:name=".webview.BrowserActivity"
            android:exported="false" />
        <activity
            android:name=".coroutine.flow.FlowActivity"
            android:exported="false" />
        <activity
            android:name=".coroutine.channel.ChannelActivity"
            android:exported="false" />
        <activity
            android:name=".coroutine.CoroutineActivity"
            android:exported="false" />
        <activity
            android:name=".cases.web.WebViewActivity"
            android:exported="false" />
        <activity
            android:name=".cases.GlideActivity"
            android:exported="false" />
        <activity
            android:name=".cases.theme.ThemeChangeActivity"
            android:exported="false" />
        <activity
            android:name=".cases.broad.AboutBroadActivity"
            android:exported="true" />
        <activity
            android:name=".cases.provider.AboutProviderActivity"
            android:exported="true" />
        <activity
            android:name=".cases.service.AboutServiceActivity"
            android:exported="true" />
        <activity
            android:name=".cases.BaseCaseActivity"
            android:exported="true" />
        <activity
            android:name=".cases.loader.ClassLoaderActivity"
            android:exported="true" />
        <activity
            android:name=".cases.start.TargetActivity"
            android:exported="true" />
        <activity
            android:name=".cases.start.StartActivity"
            android:exported="true" />
        <activity
            android:name=".cases.lam.LambdaActivity"
            android:exported="true" />
        <activity
            android:name=".cases.CaseActivity01"
            android:exported="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CodeBase.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".compose.MainActivity"
            android:exported="true" />
        <activity
            android:name=".cases.loader.replaced.DyJavaActivity"
            android:exported="true" />
        <activity
            android:name="this.is.dynamic.activity"
            android:exported="true" />

        <provider
            android:name=".cases.provider.SimpleSliceProvider"
            android:authorities="com.cleo.codebase.cases.provider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.app.slice.category.SLICE" />

                <data
                    android:host="provider.cases.codebase.cleo.com"
                    android:pathPrefix="H"
                    android:scheme="http" />
            </intent-filter>
        </provider> <!-- <provider -->
        <!-- android:name=".cases.provider.SimpleContentProvider" -->
        <!-- android:authorities="com.cleo.simple.provider" -->
        <!-- android:enabled="true" -->
        <!-- android:exported="true" /> -->
        <receiver
            android:name=".cases.broad.SimpleBroadCastReceiver"
            android:enabled="true"
            android:exported="true" />

        <service
            android:name=".cases.service.ForegroundService"
            android:enabled="true"
            android:exported="true" />
        <service
            android:name=".cases.service.SimpleService"
            android:enabled="true"
            android:exported="false" />
        <service
            android:name="this.is.dynamic.service"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>